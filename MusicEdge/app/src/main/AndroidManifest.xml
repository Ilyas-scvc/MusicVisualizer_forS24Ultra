<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Stage 1 (MVP) permissions only.

        SYSTEM_ALERT_WINDOW  - draw the edge overlay on top of other apps.
                               Granted by the user in system settings, not at runtime.
        RECEIVE_BOOT_COMPLETED - ask the system to rebind our notification listener
                               after a reboot / app update.

        Notification access (BIND_NOTIFICATION_LISTENER_SERVICE below) is what makes
        MediaSessionManager.getActiveSessions() legal for a third-party app. We never
        read notification content - see MediaEdgeListenerService.

        Stage 2 will additionally need MODIFY_AUDIO_SETTINGS and RECORD_AUDIO for the
        AudioEffect Visualizer. They are intentionally NOT declared yet: the MVP does
        no audio capture, and asking for a microphone permission before it is used
        would be both misleading and a Play policy problem.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Package visibility (Android 11+): we need to resolve the label of the app that
        currently owns the media session, and later list installed music apps for the
        whitelist screen. Scoped <queries> instead of QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MusicEdge">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden"
            android:label="@string/app_name"
            android:theme="@style/Theme.MusicEdge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The notification listener is the long-lived host of the whole engine.
            The system binds it while notification access is granted and rebinds it
            after reboot, so the app needs no foreground service and shows no
            permanent notification.
        -->
        <service
            android:name=".media.MediaEdgeListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".system.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
