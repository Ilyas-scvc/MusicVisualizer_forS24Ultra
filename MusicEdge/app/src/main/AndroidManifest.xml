<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        SYSTEM_ALERT_WINDOW    - draw the edge overlay on top of other apps.
                                 Granted by the user in system settings.
        RECEIVE_BOOT_COMPLETED - ask the system to rebind our notification listener
                                 after a reboot / app update.
        RECORD_AUDIO           - required by android.media.audiofx.Visualizer on the
                                 output mix (session 0). Only requested when the user
                                 turns on an effect that reacts to sound, and no audio
                                 is ever recorded or stored - the FFT result lives in
                                 memory for one frame.
        MODIFY_AUDIO_SETTINGS  - required to attach an AudioEffect (the Visualizer).

        Notification access (BIND_NOTIFICATION_LISTENER_SERVICE below) is what makes
        MediaSessionManager.getActiveSessions() legal for a third-party app, and it
        also carries the media-notification fallback. Only the media session token
        extra is read - never notification text.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        Package visibility (Android 11+). Scoped <queries> instead of
        QUERY_ALL_PACKAGES: media browser services and APP_MUSIC cover proper music
        players, audio/* covers file-based players, and MAIN/LAUNCHER lets the Music
        Apps screen list the remaining launchable apps so a player that declares none
        of the media filters can still be enabled by the user.
    -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MusicEdge">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden"
            android:label="@string/app_name"
            android:theme="@style/Theme.MusicEdge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The notification listener is the long-lived host of the whole engine.
            The system binds it while notification access is granted and rebinds it
            after reboot, so the app needs no foreground service and shows no
            permanent notification.
        -->
        <service
            android:name=".media.MediaEdgeListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".system.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
